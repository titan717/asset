@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; position: relative; =
}

html, body { width: 100%; height: 100%; }

html { font-size: 16px; }

body { font-family: Roboto, sans-serif; background: transparent; color: rgb=
(49, 49, 49); text-align: left; display: flex; -webkit-box-align: center; a=
lign-items: center; -webkit-box-pack: center; justify-content: center; }

.wrapper { background: rgb(255, 255, 255); width: 95%; max-width: 640px; pa=
dding: 50px 40px; display: flex; -webkit-box-align: stretch; align-items: s=
tretch; -webkit-box-pack: justify; justify-content: space-between; box-shad=
ow: rgba(0, 0, 0, 0.15) 0px 0px 3px; }

.info { display: flex; -webkit-box-orient: vertical; -webkit-box-direction:=
 normal; flex-direction: column; -webkit-box-align: start; align-items: fle=
x-start; -webkit-box-pack: justify; justify-content: space-between; width: =
55%; }

h1 { font-size: 2rem; font-weight: 400; }

.action { display: flex; -webkit-box-align: center; align-items: center; -w=
ebkit-box-pack: start; justify-content: flex-start; }

.button { background: rgb(69, 69, 216); color: rgb(255, 255, 255); padding:=
 10px 30px; border-radius: 4px; margin-right: 20px; z-index: 20; }

.button:hover { cursor: pointer; box-shadow: rgba(0, 0, 0, 0.2) 0px 0px 1px=
 2px; }

.captcha { text-align: center; color: rgb(160, 160, 160); font-size: 0.6rem=
; }

.captcha img { width: 30px; margin: 0px auto 3px; }

.pic { width: 40%; max-height: 400px; object-fit: contain; }

@media screen and (max-width: 860px) and (max-height: 440px) and (orientati=
on: landscape) {
  .wrapper { padding: 30px 20px; }
  h1 { font-size: 1.45rem; }
  .pic { max-height: 220px; }
  .captcha img { width: 25px; }
}

@media screen and (max-width: 576px) and (orientation: portrait) {
  .wrapper { padding: 50px 20px; }
